# Backend Environment Variables Example Template
# Copy this file to .env and adjust values if needed

# Server Port
PORT=5001

# MongoDB Connection String (MongoDB Compass Local: mongodb://127.0.0.1:27017/<db_name>)
MONGO_URI=mongodb://127.0.0.1:27017/queue_management

# JWT Secret Key for user authentication
JWT_SECRET=your_jwt_secret_key_here

# Node Environment Mode (development / production)
NODE_ENV=development
